{
  "name": "shmup-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server:dev": "cross-env NODE_ENV=development node --watch -r ts-node/register src/index.ts",
    "server:build": "tsc",
    "server:start": "node dist/index.js",
    "server:typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "server:test": "node --test -r ts-node/register tests/*.test.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.0",
    "@colyseus/monitor": "^0.17.7",
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.3",
    "colyseus": "^0.15.0",
    "express": "^4.18.2",
    "pg": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
