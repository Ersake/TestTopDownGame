# Copy this file to .env and fill in your values.
# Vite exposes variables prefixed with VITE_ to the client bundle.

# Local development (default)
VITE_SERVER_URL=ws://localhost:2567

# Production — set these to your deployed Colyseus relay server URLs, e.g.:
# VITE_SERVER_URL=wss://your-server.onrender.com
# VITE_SERVER_URL_1=wss://your-first-server.onrender.com
# VITE_SERVER_URL_2=wss://your-second-server.onrender.com
