# Copy this file to .env and fill in your values.
# Vite exposes variables prefixed with VITE_ to the client bundle.

# Local development (default and backward-compatible server-1 fallback)
VITE_SERVER_URL=ws://localhost:2567

# Production client — Render hosts the Colyseus servers. Configure these as
# GitHub Actions repository secrets for the Pages deployment workflow.
# VITE_SERVER_URL_1=wss://your-first-server.onrender.com
# VITE_SERVER_URL_2=wss://your-second-server.onrender.com

# Optional: set these only if the HTTP character API is hosted at a different
# origin than the WebSocket URL, or your WebSocket URL includes a route path.
# VITE_SERVER_API_URL=https://your-server.onrender.com
# VITE_SERVER_API_URL_1=https://your-first-server.onrender.com
# VITE_SERVER_API_URL_2=https://your-second-server.onrender.com

# Server process. Render supplies PORT automatically in production.
# NODE_ENV=production
# PORT=2567

# Server-side persistence. Set one of these on the Render service, not in the
# GitHub Pages client environment. Neon is the production Postgres provider.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: limit server database connections. Keep this small for Neon free/dev
# projects and small game servers.
# POSTGRES_POOL_MAX=5

# Local/file-backend storage locations. Production uses Neon; these remain
# available for local development or an explicitly configured persistent disk.
# CHARACTER_STORAGE_DIR=/absolute/path/to/characters
# MAP_STORAGE_DIR=/absolute/path/to/maps

# Optional server diagnostics. Keep disabled in production unless actively
# investigating server tick performance.
# ENEMY_DIAGNOSTICS=0
