# Copy this file to .env and fill in your values.
# Vite exposes variables prefixed with VITE_ to the client bundle.

# Local development (default)
VITE_SERVER_URL=ws://localhost:2567

# Production — set these to your deployed Colyseus relay server URLs, e.g.:
# VITE_SERVER_URL=wss://your-server.onrender.com
# VITE_SERVER_URL_1=wss://your-first-server.onrender.com
# VITE_SERVER_URL_2=wss://your-second-server.onrender.com

# Optional: set these only if the HTTP character API is hosted at a different
# origin than the WebSocket URL, or your WebSocket URL includes a route path.
# VITE_SERVER_API_URL=https://your-server.onrender.com
# VITE_SERVER_API_URL_1=https://your-first-server.onrender.com
# VITE_SERVER_API_URL_2=https://your-second-server.onrender.com

# Server-side persistence. Set one of these on the deployed Node server, not in
# the client Pages environment. Neon provides a Postgres connection string.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: limit server database connections. Keep this small for Neon free/dev
# projects and small game servers.
# POSTGRES_POOL_MAX=5
